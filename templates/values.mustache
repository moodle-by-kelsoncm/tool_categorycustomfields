{{!
    @template tool_categorycustomfields/values

    Custom field values shown on the category page.

    Context variables required for this template:
    * fields - list of fields with name, shortname, type and value (HTML formatted by the field type)

    Example context (json):
    {
        "fields": [
            {"name": "Department", "shortname": "department", "type": "text", "value": "Engineering"},
            {"name": "Budget code", "shortname": "budget", "type": "text", "value": "ENG-2026"}
        ]
    }
}}
<div class="tool-categorycustomfields card mb-3" data-tool-categorycustomfields="values">
    <div class="card-body">
        <dl class="tool-categorycustomfields-list row mb-0">
            {{#fields}}
            <dt class="col-sm-4 customfield_{{type}} customfield_{{shortname}}">{{name}}</dt>
            <dd class="col-sm-8 customfield_{{type}} customfield_{{shortname}}">{{{value}}}</dd>
            {{/fields}}
        </dl>
    </div>
</div>
